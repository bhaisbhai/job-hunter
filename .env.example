# Copy this file to .env and fill in your real secrets.
# .env is listed in .gitignore — it will never be committed.

# SMTP password (or app password) for the sender_email set in config.yaml.
# For Gmail: enable 2FA, then generate an "App Password" and use that here.
SMTP_PASSWORD=

# Anthropic API key used to evaluate scraped job listings.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
